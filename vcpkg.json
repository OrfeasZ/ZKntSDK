{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "zkntsdk",
  "version": "0.1.0",
  "dependencies": [
    "cr",
    "minhook",
    "spdlog",
    "simdjson",
    "directx-headers",
    {
      "name": "imgui",
      "features": [
        "dx12-binding",
        "win32-binding"
      ]
    },
    "directxtk12",
    "implot",
	"imguizmo",
    {
      "name": "directxtex",
      "default-features": false,
      "features": [
        "dx12"
      ]
    },
    "zlib",
    "libuv",
    {
      "name": "usockets",
      "default-features": false,
      "features": []
    },
    "uwebsockets"
  ]
}
